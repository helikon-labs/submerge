{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "aspen",
  "name": "Submerge Developer Documentation",
  "colors": {
    "primary": "#1c1c1c",
    "light": "#ffffff",
    "dark": "#ffffff"
  },
  "favicon": "/images/submerge_icon_circular.png",
  "fonts": {
    "family": "Inter"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Introduction",
        "groups": [
          {
            "group": "Getting started",
            "pages": ["index", "quickstart", "development"]
          },
          {
            "group": "Customization",
            "pages": ["essentials/settings", "essentials/navigation"]
          },
          {
            "group": "Writing content",
            "pages": [
              "essentials/markdown",
              "essentials/code",
              "essentials/images",
              "essentials/reusable-snippets"
            ]
          }
        ]
      },
      {
        "tab": "Crystal API reference",
        "openapi": "/api-reference/petstore.yaml"
      }
    ],
    "global": {
      "anchors": []
    }
  },
  "logo": {
    "light": "/logo/submerge_logo_black.png",
    "dark": "/logo/submerge_logo_white.png"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:info@helikon.io"
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/helikon-labs",
      "github": "https://github.com/helikon-labs/submerge"
    }
  }
}
