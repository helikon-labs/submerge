{
    "name": "submerge-crystal-legacy-decoder",
    "version": "0.1.0",
    "description": "Submerge Crystal pre-metadata-V14 decoder service.",
    "main": "index.js",
    "scripts": {
        "format:check": "prettier . --check",
        "format": "prettier . --write",
        "lint": "eslint ./",
        "build": "rimraf dist && tsc",
        "predev": "npm run build",
        "dev": "cross-env NODE_ENV=development concurrently \"tsc --watch\" \"nodemon -q dist/app.js\"",
        "prestart": "npm run build",
        "start": "cross-env NODE_ENV=production node dist/app.js",
        "test": "echo \"Error: no test specified\" && exit 1"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/helikon-labs/submerge.git"
    },
    "keywords": [],
    "author": "kukabi <kutsal@helikon.io>",
    "license": "GPL 3",
    "bugs": {
        "url": "https://github.com/helikon-labs/submerge/issues"
    },
    "homepage": "https://github.com/helikon-labs/submerge#readme",
    "dependencies": {},
    "devDependencies": {
        "@polkadot/api": "^16.3.1",
        "@polkadot/types": "./lib/polkadot-types-16.3.1.tgz",
        "@typescript-eslint/eslint-plugin": "^8.35.1",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.3",
        "concurrently": "8.2.2",
        "cors": "^2.8.5",
        "cross-env": "^7.0.3",
        "eslint": "^9.30.0",
        "express": "^5.1.0",
        "helmet": "^8.1.0",
        "http-status-codes": "^2.3.0",
        "lru-cache": "^11.1",
        "nodemon": "3.1.4",
        "prettier": "^3.6.2",
        "rimraf": "^6.0.1",
        "typescript": "5.8.3"
    },
    "overrides": {
        "@polkadot/types-codec": "./lib/polkadot-types-codec-16.3.1.tgz"
    }
}
